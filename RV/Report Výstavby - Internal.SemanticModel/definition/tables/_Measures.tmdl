	measure 'KPI Status' =
			
			VAR StatusROP = CALCULATE ( MAX ( DIM_STAV[Stav] ), DIM_SUBFAZE[Subfaze] = "Příprava Dokumentace Rozvláknení" )
			RETURN
			SWITCH(
			    TRUE(),
			    StatusROP = "Hotovo", "Home Passed",
			    StatusROP = "Pozastaveno", "Čeká na Přívod/VR",
			    --NOT ISBLANK([Reklamace Duration]), "Reklamace",
			    [KPI Trváni] <= 20, "Beze Zpoždění",
			    [KPI Trváni] <= 30, "Možné Zpoždění",
			    NOT ISBLANK ( [KPI Trváni] ), "Ve Zpoždění",
			    BLANK()
			)
		displayFolder: ROP do Komerce
		lineageTag: 0f04d75d-c359-4027-9586-ab763b275798

	measure Test = ```
			
			CALCULATE(
			    COUNTROWS(VALUES(DIM_STAV[Stav])),
			    DIM_SUBFAZE[Subfaze] = "Příprava Dokumentace Rozvláknení"
			)
			
			```
		formatString: 0
		displayFolder: ROP do Komerce
		lineageTag: 375249c6-2a12-4ff9-a58e-2c98b54a62e0

	measure 'KPS4 Trvání' =
			
			VAR milestoneStart = [Dokumentace Odevzdaná]
			VAR milestoneEnd =
			    CALCULATE (
			        MAX ( FACT_VYSTAVBA[Konec Real] ),
			        FACT_VYSTAVBA[Subfaze_Key] = "37"
			    )
			VAR HasStart = NOT ISBLANK(milestoneStart)
			VAR HasEnd   = NOT ISBLANK(milestoneEnd)
			VAR EndOrNow = COALESCE(milestoneEnd, NOW())
			VAR Diff     = IF(HasStart, DATEDIFF(milestoneStart, EndOrNow, DAY))
			RETURN
			SWITCH(
			    TRUE(),
			    HasEnd && NOT HasStart,                              1,        -- end only
			    NOT HasEnd && NOT HasStart,                          BLANK(),  -- neither
			    HasStart && HasEnd && milestoneEnd < milestoneStart, 1,        -- end before start
			    HasStart && Diff = 0,                                1,        -- same day
			    HasStart,                                            Diff      -- both or start-only
			)
		formatString: 0
		displayFolder: ROP do Komerce
		lineageTag: f3f52238-280e-4a54-9d43-e7814e5d9ad8

	partition _Measures = m
