	measure 'HP Kumulativní Součet' =
			
			VAR CurrentDate = MAX ( DIM_CALENDAR[Datum] )
			VAR MaxDateWithData =
			    CALCULATE (
			        MAX ( FACT_VYSTAVBA_MILNIK[Datum] ),
			        REMOVEFILTERS ( DIM_CALENDAR )
			    )
			RETURN
			IF (
			    CurrentDate <= MaxDateWithData,
			    CALCULATE (
			        SUM ( FACT_VYSTAVBA_MILNIK[Pocet HP] ),
			        FILTER (
			            ALL ( DIM_CALENDAR ),
			            DIM_CALENDAR[Datum] <= CurrentDate
			        )
			    )
			)
		formatString: #,0
		displayFolder: Průběžné Plnění
		lineageTag: e4256849-62a8-4f45-b008-c4f253b96748

	measure 'Obousměrné filtrování Výstavba' =
			
