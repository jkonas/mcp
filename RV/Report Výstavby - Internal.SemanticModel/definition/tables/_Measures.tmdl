	measure 'Průběžné Plnění HP za IA' = ```
			
			-- 1. Získáme unikátní seznam ROP_Key, které v Lednu splnily daný Milník
			VAR FilteredROP = 
			    CALCULATETABLE ( 
			        VALUES ( FACT_VYSTAVBA_MILNIK[ROP_Key] )
			    )
			
			RETURN
			IF ( 
			    -- 2. Tato podmínka zajistí, že se ve vizuálu IA/KIA zobrazí jen ty řádky,
			    -- které mají v Lednu aspoň jeden záznam v milnících
			    NOT ISEMPTY ( FilteredROP ),
			
			    CALCULATE ( 
			        SUM ( FACT_VYSTAVBA_SUBJEKT[Pocet HP] ),
			        -- 3. Klíčový krok: "Vstříkneme" vyfiltrované klíče ROP přímo do dimenze ROP.
			        -- Tím zajistíme, že FACT_VYSTAVBA_SUBJEKT uvidí jen ty ROPy z Ledna.
			        TREATAS ( FilteredROP, DIM_ROP[ROP_Key] )
			    )
			)
			```
		formatString: 0
		displayFolder: Průběžné Plnění
		lineageTag: 58e9c9fa-0283-4e0f-9f31-004c6a55124d

