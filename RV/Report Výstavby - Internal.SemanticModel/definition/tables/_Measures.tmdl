	measure 'HP V Nejakém Zpoždění' = ```
			
			SUMX(
			    VALUES ( MILESTONES_KOMERCE[ROP_Key] ),
			    VAR ROP_KPI_Status = CALCULATE ( MAX ( MILESTONES_KOMERCE[ROP KPI Status] ) )
			    VAR SUM_HP = [Počet HP]
			    RETURN
			        IF (
			            ROP_KPI_Status IN { "Reklamace", "Možné Zpoždění", "V Zpoždění" },
