	measure 'ROP Milestone Duration (Výstupní Kontrola)' = ```
			
			MAXX(
			    VALUES(MILESTONES_KOMERCE[ROP_Key]),
			    VAR milestoneStart =
			        CALCULATE(
			            MIN(MILESTONES_KOMERCE[Milnik Datum]),
			            KEEPFILTERS(MILESTONES_KOMERCE[Milnik ID] = 103)
			        )
			    VAR milestoneEnd =
			        CALCULATE(
			            MAX(MILESTONES_KOMERCE[Milnik Datum]),
			            KEEPFILTERS(MILESTONES_KOMERCE[Milnik ID] = 104)
			        )
			    VAR HasStart = NOT ISBLANK(milestoneStart)
			    VAR HasEnd   = NOT ISBLANK(milestoneEnd)
			    VAR EndOrNow = COALESCE(milestoneEnd, NOW())
			    VAR Diff     = IF(HasStart, DATEDIFF(milestoneStart, EndOrNow, DAY))
			    RETURN
			        SWITCH(
			            TRUE(),
			            HasEnd && NOT HasStart,                              1,        -- end only
			            NOT HasEnd && NOT HasStart,                          BLANK(),  -- neither
			            HasStart && HasEnd && milestoneEnd < milestoneStart, 1,        -- end before start
			            HasStart && Diff = 0,                                1,        -- same day
			            HasStart,                                            Diff      -- both or start-only
			        )
			)
			
			```
		formatString: 0
		displayFolder: Průběžné Plnění - Komerce
		lineageTag: 37ba0037-da56-4dee-a8ee-3abb9b060763

	measure 'ROP Milestone Duration (KPS4) KPI Formatting' =
			
			MAXX(
			    VALUES( MILESTONES_KOMERCE[ROP_Key] ),
			    VAR StatusMax =
			        CALCULATE( MAX( MILESTONES_KOMERCE[ROP KPI Status] ) )
			    VAR Dur = [ROP Milestone Duration (KPS4)]
			    RETURN
			        IF(
			            Dur >= 2 &&
			            StatusMax IN { "Beze zpoždění", "Možné zpoždění", "V zpoždění" },
			            "#F12E49"
			        )
			)
		displayFolder: Průběžné Plnění - Komerce
		lineageTag: f4ab9ff9-c679-49ac-98e8-ccabd9e8c8ba

