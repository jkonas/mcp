	measure 'Typ Subjektu' =
			
			VAR _selectedSubjekty =
			    SUMMARIZE (
			        FILTER (
			            VALUES ( DIM_SUBJEKT ),
			            NOT ISBLANK ( DIM_SUBJEKT[Subjekt] )
			                && NOT ISBLANK ( [Počet HP Subjekt] )
			        ),
			        DIM_SUBJEKT[Subjekt],
			        DIM_SUBJEKT[Subjekt Poradi]
			    )
			RETURN
			    IF (
			        ISBLANK ( [Počet HP Subjekt] ),
			        BLANK (),
			        CONCATENATEX (
			            _selectedSubjekty,
			            DIM_SUBJEKT[Subjekt],
			            ", ",
			            [Subjekt Poradi],
			            ASC
			        )
			    )
		displayFolder: Aktuální Status
