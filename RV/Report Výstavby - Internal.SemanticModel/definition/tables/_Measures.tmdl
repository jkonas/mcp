	measure PoznamkaPc =
			
			VAR LastChange =
			    SELECTEDVALUE ( DIM_KIA[Poznamka - Naposled Upraveno] )
			VAR RawNote =
			    SELECTEDVALUE ( DIM_KIA[Poznamka] )
			VAR NormText =
			    SUBSTITUTE (
			        SUBSTITUTE ( RawNote, UNICHAR ( 13 ) & UNICHAR ( 10 ), UNICHAR ( 10 ) ),
			        UNICHAR ( 13 ),
			        UNICHAR ( 10 )
			    )
			VAR NoDoubles =
			    SUBSTITUTE ( NormText, UNICHAR ( 10 ) & UNICHAR ( 10 ), UNICHAR ( 10 ) )
			VAR Header =
			    IF (
			        ISBLANK ( LastChange ),
			        "Naposledy Změněno: Nedostupno",
			        "Naposledy Změněno: " & LastChange
			    )
			VAR Body =
			    IF ( ISBLANK ( NoDoubles ), "Nedostupno", NoDoubles )
			VAR Combined =
			    Header & "<<HDR>>" & Body
			RETURN
			    SUBSTITUTE ( Combined, UNICHAR ( 10 ), "|||" )
		displayFolder: FAST Lite
		lineageTag: e7d689bf-2655-4a47-a41d-1c4d7cf220cf

	measure PoznamkaProjekce =
			
			VAR LastChange =
			    SELECTEDVALUE ( DIM_KIA[Projekce - Poznamka Projektovy Koordinator Naposled Upraveno] )
			VAR RawNote =
			    SELECTEDVALUE ( DIM_KIA[Projekce - Poznamka Projektovy Koordinator] )
			VAR NormText =
			    SUBSTITUTE (
			        SUBSTITUTE ( RawNote, UNICHAR ( 13 ) & UNICHAR ( 10 ), UNICHAR ( 10 ) ),
			        UNICHAR ( 13 ),
			        UNICHAR ( 10 )
			    )
			VAR NoDoubles =
			    SUBSTITUTE ( NormText, UNICHAR ( 10 ) & UNICHAR ( 10 ), UNICHAR ( 10 ) )
			VAR Header =
			    IF (
			        ISBLANK ( LastChange ),
			        "Naposledy Změněno: Nedostupno",
			        "Naposledy Změněno: " & LastChange
			    )
			VAR Body =
			    IF ( ISBLANK ( NoDoubles ), "Nedostupno", NoDoubles )
			VAR Combined =
			    Header & "<<HDR>>" & Body
			RETURN
			    SUBSTITUTE ( Combined, UNICHAR ( 10 ), "|||" )
		displayFolder: FAST Lite
		lineageTag: 13b1dfe4-4985-4694-8ea2-5a10d6a79dfd

