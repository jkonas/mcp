	measure 'Počet HP' =
			
			SUMX(
			        VALUES(MILESTONES_KOMERCE[ROP_Key]),
			        CALCULATE(
			            MAX(MILESTONES_KOMERCE[Pocet HP]),
			            ALLEXCEPT(MILESTONES_KOMERCE, MILESTONES_KOMERCE[ROP_Key], MILESTONES_KOMERCE[Milnik])
			        )
			    )
