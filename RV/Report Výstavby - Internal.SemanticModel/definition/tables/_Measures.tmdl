	measure 'Status Full' = ```
			
			VAR substatus =
			CALCULATE ( 
			    MAX ( DIM_ROP[Substatus] ),
			    FACT_VYSTAVBA[Aktualni Stav] = TRUE(),
			    CROSSFILTER ( DIM_ROP[ROP_Key], FACT_VYSTAVBA[ROP_Key], BOTH )  
			)
			VAR hlavniStatus = 
			CALCULATE ( 
			    MAX ( DIM_FAZE[Faze] ),
			    FACT_VYSTAVBA[Aktualni Stav] = TRUE(),
			    CROSSFILTER ( DIM_FAZE[Faze_Key], FACT_VYSTAVBA[Faze_Key], BOTH )  
			)
			RETURN
			COALESCE ( substatus, hlavniStatus )
			```
		lineageTag: 2bdd8438-102c-4b28-9afb-a4ade44977a0

