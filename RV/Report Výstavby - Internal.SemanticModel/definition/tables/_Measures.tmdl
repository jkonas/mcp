			            DIM_FAZE[Faze] = "V Projekci",
			            FACT_VYSTAVBA[Aktualni Stav] = TRUE(),
			            REMOVEFILTERS ( DIM_KIA[Kraj] )
			        ),
			        0
			    ),
			    BLANK()
			)
		formatString: 0
		displayFolder: Utilizace\Projekce
		lineageTag: d5b4696e-ce20-455c-b9b2-7e3993989116

	measure 'Aktuální Kapacita Region' = ```
			
