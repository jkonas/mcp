	measure 'ROP Milestone Duration (KPS4)' = ```
			
			MAXX(
			    VALUES(MILESTONES_KOMERCE[ROP_Key]),
			    VAR milestoneStart =
			        CALCULATE(
			            MIN(MILESTONES_KOMERCE[Milnik Datum]),
			            KEEPFILTERS(MILESTONES_KOMERCE[Milnik ID] = 73)
			        )
			    VAR milestoneEnd =
			        CALCULATE(
			            MAX(MILESTONES_KOMERCE[Milnik Datum]),
			            KEEPFILTERS(MILESTONES_KOMERCE[Milnik ID] = 74)
			        )
			    VAR HasStart = NOT ISBLANK(milestoneStart)
			    VAR HasEnd   = NOT ISBLANK(milestoneEnd)
			    VAR EndOrNow = COALESCE(milestoneEnd, NOW())
			    VAR Diff     = IF(HasStart, DATEDIFF(milestoneStart, EndOrNow, DAY))
			    RETURN
			        SWITCH(
			            TRUE(),
			            HasEnd && NOT HasStart,                              1,        -- end only
			            NOT HasEnd && NOT HasStart,                          BLANK(),  -- neither
			            HasStart && HasEnd && milestoneEnd < milestoneStart, 1,        -- end before start
			            HasStart && Diff = 0,                                1,        -- same day
			            HasStart,                                            Diff      -- both or start-only
			        )
			)
			
			```
		formatString: 0
		displayFolder: Průběžné Plnění - Komerce
		lineageTag: 88187908-d2ef-430c-bc19-eeb98c39897a

