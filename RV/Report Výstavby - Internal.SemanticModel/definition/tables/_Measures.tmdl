	measure 'Počet IA' = ```
			
			VAR VybranyMesicZacatek = MIN ( DIM_CALENDAR[MONTH_FIRST_DATE] )
			VAR VybranyMesicKonec = MAX ( DIM_CALENDAR[MONTH_LAST_DATE] )
			RETURN
			CALCULATE ( 
			    DISTINCTCOUNT ( FACT_VYSTAVBA[KIA_Key] ),
			    DIM_FAZE[Faze] = "V Projekci",
			    NOT DIM_ROP[Status] IN { "Zrušeno", "Pozastaveno" }, -- Bere se status místo stavu, jelikož ROP může být aktivní v projekci, ačkoliv je již zrušená jinde
			    FACT_VYSTAVBA[Start Real] <= VybranyMesicKonec &&
			    COALESCE ( FACT_VYSTAVBA[Konec Real], FACT_VYSTAVBA[Konec Forecast] ) >= VybranyMesicZacatek
			)
			```
		formatString: 0
		displayFolder: Utilizace\Projekce
		lineageTag: e85469df-0749-4423-8113-ae4f510df3b6

