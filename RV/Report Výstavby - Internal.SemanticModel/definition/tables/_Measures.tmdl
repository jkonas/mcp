	measure 'Aktuální Počet IA Region' =
			
			VAR Dodavatel = SELECTEDVALUE ( DIM_DODAVATEL[Dodavatel] )
			VAR Kraj = SELECTEDVALUE ( DIM_KIA[Kraj] )
			VAR ExistujeRegionalita =
			    CALCULATE (
			        COUNTROWS ( FACT_REGIONALITA ),
			        FACT_REGIONALITA[Dodavatel] = Dodavatel,
			        DIM_KIA[Kraj] = Kraj,
			        FACT_REGIONALITA[Typ] = "Projekce"
			    )
			VAR PocetIA =
			    CALCULATE (
			        DISTINCTCOUNT ( FACT_VYSTAVBA[KIA_Key] ),
			        FACT_VYSTAVBA[Aktualni Stav] = TRUE(),
			        DIM_FAZE[Faze] = "V Projekci"
			    )
			RETURN
			IF (
			    ExistujeRegionalita > 0,
			    COALESCE ( PocetIA, 0 ),
			    BLANK()
			)
		formatString: 0
		displayFolder: Utilizace\Projekce
		lineageTag: 7a11a70c-b215-4a6f-a7b3-667b0cbbb806

	measure 'Celkový Počet IA Region' =
			
			VAR Dodavatel = SELECTEDVALUE ( DIM_DODAVATEL[Dodavatel] )
			VAR Kraj = SELECTEDVALUE ( DIM_KIA[Kraj] )
			VAR ExistujeRegionalita =
			    CALCULATE (
			        COUNTROWS ( FACT_REGIONALITA ),
			        FACT_REGIONALITA[Dodavatel] = Dodavatel,
			        DIM_KIA[Kraj] = Kraj,
			        FACT_REGIONALITA[Typ] = "Projekce"
			    )
			RETURN
			IF (
			    ExistujeRegionalita > 0,
			    COALESCE(
