	measure 'Dodavatel Realizace' =
			
			VAR Plneni = [Průběžné Plnění HP za IA]
			RETURN
			IF (
			    NOT ISBLANK ( Plneni ), -- Kontrola, zda existuje HP
			    CALCULATE (
			        MAX ( DIM_DODAVATEL[Dodavatel] ),
			        DIM_FAZE[Faze] IN { "V Realizaci", "Dokumentace Odevzdána", "Home Passed", "V Komerci" }, -- ošetření chyby, kdy je KIA v Realizaci, ale vybrané roky nemá žádné HP v realizaci. Dodavatel se skryl - vložením více následných fázi se daný problém ošetří.
			        ALL ( DIM_MILESTONE[Milnik] ),
			        ALL ( DIM_CALENDAR ),
			        CROSSFILTER ( FACT_VYSTAVBA_MILNIK[Dodavatel_Key], DIM_DODAVATEL[Dodavatel_Key], Both )
			    )
			)
		displayFolder: Průběžné Plnění
		lineageTag: e265e613-ad40-4545-abba-0ce44bb15f04

