	measure 'Utilizace Realizace' = [Měsíční Rozpočet Kapacita] - [Rozpočet IA]
		formatString: # ##0
		displayFolder: Utilizace\Realizace
		lineageTag: 6e204051-1489-48ec-b351-be430b19b720

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Rozpočet IA' = ```
			
			// Pokud ROP je již dále než v realizaci (aktuální stav) a není vyplněný konec za ROP v realizaci, tato ROP se stále počítá jako v realizaci. V rámci historie nelze brát ohled na aktuální stav. 
			VAR VybranyMesicZacatek = MIN ( DIM_CALENDAR[MONTH_FIRST_DATE] )
			VAR VybranyMesicKonec = MAX ( DIM_CALENDAR[MONTH_LAST_DATE] )
			VAR KIAvRealizaci =
			SELECTCOLUMNS (
			    FILTER (
			        FACT_VYSTAVBA,
			        RELATED ( DIM_FAZE[Faze] ) = "V Realizaci" && NOT RELATED( DIM_ROP[Status] ) IN { "Zrušeno", "Pozastaveno" } && FACT_VYSTAVBA[Start Real] <= VybranyMesicKonec &&
			    COALESCE ( FACT_VYSTAVBA[Konec Real], FACT_VYSTAVBA[Konec Forecast], DATE(9999, 12, 31) ) >= VybranyMesicZacatek
			    ),  -- Bere se status místo stavu, jelikož ROP může být aktivní v projekci, ačkoliv je již zrušená jinde. Prázdný konec realizace zároveň značí, že ještě se neví, kdy se ROP ukončí - proto napevno datum.
			    "KIA", RELATED ( DIM_KIA[KIA] )
			)
			RETURN
			CALCULATE (
			    SUM ( FACT_REALIZACE[CAPEX] ),
			    TREATAS ( KIAvRealizaci, DIM_KIA[KIA] )
			)
			```
		displayFolder: Utilizace\Realizace
		lineageTag: da6968d6-7561-4c36-92af-a1ae450d64a7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Měsíční Rozpočet Kapacita' = ```
			
			CALCULATE ( 
			    SUM ( 'FACT_KAPACITA'[Kapacita rocni - rozpocet] )
			)
			```
		formatString: 0
		displayFolder: Utilizace\Realizace
		lineageTag: 03cbaacb-a18d-42fc-956d-304e51cb9991

	measure 'Celkový Rozpočet Kraj' =
			
			VAR Dodavatel = SELECTEDVALUE ( DIM_DODAVATEL[Dodavatel] )
			VAR Kraj = SELECTEDVALUE ( DIM_KIA[Kraj] )
			VAR ExistujeRegionalita =
			    CALCULATE (
			        COUNTROWS ( FACT_REGIONALITA ),
			        FACT_REGIONALITA[Dodavatel] = Dodavatel,
			        DIM_KIA[Kraj] = Kraj,
			        FACT_REGIONALITA[Typ] = "Realizace"
			    )
			VAR AktualniKIAvRealizaci =
			CALCULATETABLE (
			    VALUES(DIM_KIA[KIA]),
			    FACT_VYSTAVBA[Aktualni Stav] = TRUE(),
			    DIM_KIA[Status] = "V Realizaci",
			    REMOVEFILTERS ( DIM_KIA[Kraj] ),
			    CROSSFILTER ( DIM_KIA[KIA_Key], FACT_VYSTAVBA[KIA_Key], BOTH )
			)
			VAR Result =
			IF (
			    ExistujeRegionalita > 0,
			    COALESCE(
			        CALCULATE (
			            SUM ( FACT_REALIZACE[CAPEX] ),
			            TREATAS ( AktualniKIAvRealizaci, DIM_KIA[KIA] ),
			            REMOVEFILTERS ( DIM_KIA[Kraj] )
			        ),
			        0
			    ),
			    BLANK()
			)
			RETURN
			Result
		formatString: #,0
		displayFolder: Utilizace\Realizace
		lineageTag: 47437b7e-accb-4d8c-9f23-d698f041990e

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Aktuální Rozpočet Kapacita Region' = ```
			
