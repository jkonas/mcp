	measure HP_FAZI_V_MESIACI =
			
			VAR MonthStart = MIN ( DIM_CALENDAR[Datum] )
			VAR MonthEnd   = MAX ( DIM_CALENDAR[Datum] )
			
			VAR PhaseLevel =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            KIA_AGG_DATES,
			            KIA_AGG_DATES[KIA],
			            KIA_AGG_DATES[FAZE_ID]
			        ),
			        "StartDate",
			            CALCULATE (
			                MINX (
			                    KIA_AGG_DATES,
			                    COALESCE ( KIA_AGG_DATES[FAZE_START_REAL], KIA_AGG_DATES[FAZE_START_MODEL] )
			                )
			            ),
			        "EndDate",
			            CALCULATE (
			                MAXX (
			                    KIA_AGG_DATES,
			                    COALESCE ( KIA_AGG_DATES[FAZE_KONEC_REAL], KIA_AGG_DATES[FAZE_KONEC_MODEL] )
			                )
			            ),
			        "HP", CALCULATE ( MAX ( KIA_AGG_DATES[POCET_HP] ) )
			    )
			
			RETURN
			SUMX (
			    FILTER (
			        PhaseLevel,
			        NOT ISBLANK ( [StartDate] )
			            && NOT ISBLANK ( [EndDate] )
			            && [StartDate] <= MonthEnd
			            && [EndDate] >= MonthStart
			    ),
			    [HP]
			)
		formatString: 0
		lineageTag: f0fc88a1-a1c6-49d6-b798-01c9077a91fc

	measure KIA_DETAIL_LINK =
			
			VAR SelectedKIA =
			    SELECTEDVALUE ( KIA_AGG_DATES[KIA] )
			
			VAR SelectedStatus =
			    SELECTEDVALUE ( KIA_AGG_DATES[STATUS_KIA] )
			
			VAR BaseUrl =
			    "https://app.powerbi.com/groups/me/apps/2ed33be5-9b42-402d-be1c-123954ed0bd6/reports/9ec301b9-7f94-4c0f-9843-d48fd7ada363/"
			
			VAR PageName =
			    SWITCH (
			        TRUE(),
			        SelectedStatus = "Zásobník ABC",          "8ee4bcd58491b07475e0",
			        SelectedStatus = "V Řešení U ABC",        "8ee4bcd58491b07475e0",
			        SelectedStatus = "Zásobník Plánování",    "80ba3c21bc3113a1e508",
			        SelectedStatus = "V Plánování",           "80ba3c21bc3113a1e508",
			        SelectedStatus = "Zásobník Projekce",     "c03bfa881995e09abe10",
			        SelectedStatus = "V Projekci",            "c03bfa881995e09abe10",
			        SelectedStatus = "Zásobník Realizace",    "b164fe001602c5dc3e6e",
			        SelectedStatus = "V Realizaci",           "b164fe001602c5dc3e6e",
			        SelectedStatus = "V IK1",                 "85af553d806678892203",
			        SelectedStatus = "V IK2",                 "85af553d806678892203",
			        SelectedStatus = "Home Passed",           "a954ee5390b00c0eed4b",
			        SelectedStatus = "Dokumentace Odevzdána", "b164fe001602c5dc3e6e",
			        "ReportSection_KIA_Detail"
			    )
			
			RETURN
			IF (
			    NOT ISBLANK ( SelectedKIA ),
			    BaseUrl
			        & PageName
			        & "?filter=DIM_KIA/KIA eq '"
			        & SelectedKIA
			        & "'",
			    BLANK()
			)
		lineageTag: f0fc817c-06b1-4881-bb4b-ff0ced979d44
		dataCategory: WebUrl

