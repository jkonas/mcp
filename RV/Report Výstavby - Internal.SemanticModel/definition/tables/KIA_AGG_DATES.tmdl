	column STATUS_KIA =
			
			RELATED ( DIM_KIA[Status] )
		lineageTag: d4ac1bd6-347d-42ad-9f52-8464dba292a0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column AKTUALNI_SUBFAZE_FLAG_COL =
			
			VAR _KIA      = KIA_AGG_DATES[KIA]
			VAR _ThisFaze = KIA_AGG_DATES[FAZE]
			VAR _ThisSub  = KIA_AGG_DATES[SUB_FAZE_ID]
			
			-- 1) Zisti aktuálnu fázu (status) pre danú KIA (nezávisle od riadku)
			VAR _StatusFaze =
			    CALCULATE (
			        MAX ( KIA_AGG_DATES[STATUS_KIA] ),
			        FILTER ( ALL ( KIA_AGG_DATES ), KIA_AGG_DATES[KIA] = _KIA )
			    )
			
			-- Ak tento riadok nie je v aktuálnej fáze, nemá dostať 1
			VAR _IsAktualnaFaza = _ThisFaze = _StatusFaze
			
			-- 2) Podmnožina: len riadky danej KIA v aktuálnej fáze, bez SUB_FAZE_ID = 20
			VAR _AktualnaFazaSet =
			    FILTER (
			        ALL ( KIA_AGG_DATES ),
			        KIA_AGG_DATES[KIA] = _KIA
			            && KIA_AGG_DATES[FAZE] = _StatusFaze
			            && KIA_AGG_DATES[SUB_FAZE_ID] <> 20
			    )
			
			-- 3) Subfázy s aspoň jedným reálnym dátumom (start alebo konec)
			VAR _SetSDatumom =
			    FILTER (
			        _AktualnaFazaSet,
			        NOT ISBLANK ( KIA_AGG_DATES[SUB_START_REAL] )
			            || NOT ISBLANK ( KIA_AGG_DATES[SUB_KONEC_REAL] )
			    )
			
			-- 4) Výber aktuálnej subfázy v rámci aktuálnej fázy
			VAR _AktualnaSubFazaID =
			    IF (
			        COUNTROWS ( _SetSDatumom ) > 0,
			        MAXX ( _SetSDatumom, KIA_AGG_DATES[SUB_FAZE_ID] ),
			        MINX ( _AktualnaFazaSet, KIA_AGG_DATES[SUB_FAZE_ID] )
			    )
			
			RETURN
			IF (
			    _IsAktualnaFaza
			        && _ThisSub = _AktualnaSubFazaID,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 7bd068d4-c71d-432b-8cda-2e28f351ee13
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column KIA_NORMA_DAYS = ```
			
			VAR _KIA = KIA_AGG_DATES[KIA]
			
			VAR _StartBaseline =
			    CALCULATE (
			        MIN ( KIA_AGG_DATES[SUB_START_MODEL_BASELINE] ),
			        FILTER (
			            KIA_AGG_DATES,
			            KIA_AGG_DATES[KIA] = _KIA
			                && KIA_AGG_DATES[SUB_FAZE_ID] = 1
			        )
			    )
			
			VAR _EndBaseline =
			    CALCULATE (
			        MAX ( KIA_AGG_DATES[SUB_KONEC_MODEL_BASELINE] ),
			        FILTER (
			            KIA_AGG_DATES,
			            KIA_AGG_DATES[KIA] = _KIA
			                && KIA_AGG_DATES[SUB_FAZE_ID] = 42
			        )
			    )
			
			RETURN
			IF (
			    ISBLANK ( _StartBaseline )
			        || ISBLANK ( _EndBaseline ),
			    BLANK (),
			    DATEDIFF ( _StartBaseline, _EndBaseline, DAY )
			)
			
			```
		formatString: 0
		lineageTag: c0ff3fce-0fa2-45e5-bd76-c5ee165a7cea
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column KIA_START_REAL = ```
			
			VAR _KIA = KIA_AGG_DATES[KIA]
			RETURN
			CALCULATE (
			    MIN ( KIA_AGG_DATES[SUB_START_REAL] ),
			    FILTER (
			        KIA_AGG_DATES,
			        KIA_AGG_DATES[KIA] = _KIA
			            && KIA_AGG_DATES[SUB_FAZE_ID] = 1
