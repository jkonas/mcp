	column FAZE_REAL_DURATION_DAYS_COL = ```
			
			VAR StartDate =
			    KIA_AGG_DATES[FAZE_START_REAL]
			
			VAR RealEnd =
			    KIA_AGG_DATES[FAZE_KONEC_REAL]
			
			VAR ModelEnd =
			    KIA_AGG_DATES[FAZE_KONEC_MODEL]
			
			VAR TodayDate =
			    TODAY()
			
			VAR EffectiveEndDate =
			    IF (
			        NOT ISBLANK ( RealEnd ),
			        RealEnd,                                  -- fáza ukončená
			        IF (
			            NOT ISBLANK ( ModelEnd ) && TodayDate > ModelEnd,
			            TodayDate,                            -- po modeli → meškanie rastie
			            TodayDate                             -- pred modelom → stále beží
			        )
			    )
			
			RETURN
			IF (
			    ISBLANK ( StartDate ) || ISBLANK ( EffectiveEndDate ),
			    BLANK (),
			    DATEDIFF ( StartDate, EffectiveEndDate, DAY )
			)
			
			```
		formatString: 0
		lineageTag: 162fca46-9fee-47ad-9674-4e7d7902d4d3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

