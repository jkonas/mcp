	measure HP_V_FAZI_AKTUALNE = ```
			
			VAR DatumGrafu =
			    MAX ( DIM_CALENDAR[Datum] )
			
			RETURN
			SUMX (
			    VALUES ( KIA_AGG_DATES[KIA] ),
			    VAR StartDate =
			        [FAZE_START_DATE]
			
			    VAR EndDate =
			        [FAZE_KONEC_DATE]
			
			    VAR HP =
			        MAX ( KIA_AGG_DATES[POCET_HP] )
			
			    RETURN
			        IF (
			            NOT ISBLANK ( StartDate )
			                && NOT ISBLANK ( EndDate )
			                && DatumGrafu >= StartDate
			                && DatumGrafu < EndDate,
			            HP,
			            0
			        )
			)
			
			```
		formatString: 0
		lineageTag: 443511de-021d-4c6a-9383-7b4cab3e4bbf

