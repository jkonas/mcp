	column Zpozdeni_flag = ```
			
			VAR Rozdil = KIA_AGG_DATES[FAZE_ROZDIL_DNI]
			VAR Norma  = KIA_AGG_DATES[FAZE_NORMA_DAYS]
			VAR Limit50 = Norma * 1
			RETURN
			SWITCH (
			    TRUE(),
			    ISBLANK(Rozdil) || ISBLANK(Norma), BLANK(),
			
			    Rozdil <= 0,
			        "bez zpoždení",
			
			    Rozdil > 0 && Rozdil <= Limit50,
			        "mírné zpoždení",
			
			    "vyšší zpoždení"
			)
			
			```
