table KIA_AGG_DATES
	lineageTag: dc207c86-503d-4d09-9bb2-47a274f30ffa

	measure ZPOZDENI_COLOR_FAZE = ```
			
			VAR Rozdil = SELECTEDVALUE ( KIA_AGG_DATES[FAZE_ROZDIL_DNI] )
			VAR Norma  = SELECTEDVALUE ( KIA_AGG_DATES[FAZE_NORMA_DAYS] )
			VAR Limit50 = Norma * 1
			RETURN
			SWITCH (
			    TRUE (),
			
			    ISBLANK ( Rozdil ) || ISBLANK ( Norma ),
			        BLANK (),
			
			    Rozdil <= 0,
			        "#4CAF50",        -- zelená (bez zpoždení)
			
			    Rozdil > 0 && Rozdil <= Limit50,
			        "#FFC107",        -- oranžová (mírné zpoždení)
			
			        "#F44336"         -- červená (vyšší zpoždení)
			)
			
			```
		lineageTag: 894d1645-5451-40a9-854d-294e851633a8

