	column KIA_REAL_DURATION_DAYS_COL = ```
			
			VAR _KIA =
			    KIA_AGG_DATES[KIA]
			
			/* 1️⃣ Začiatok KII */
			VAR StartDate =
			    KIA_AGG_DATES[KIA_START_REAL]
			
			/* 2️⃣ Najvyššia subfáza s reálnym dátumom */
			VAR LastSubID =
			    CALCULATE (
			        MAX ( KIA_AGG_DATES[SUB_FAZE_ID] ),
			        FILTER (
			            KIA_AGG_DATES,
			            KIA_AGG_DATES[KIA] = _KIA
			                && NOT ISBLANK ( KIA_AGG_DATES[SUB_START_REAL] )
			        )
			    )
			
			/* 3️⃣ Reálny dátum poslednej známej subfázy */
			VAR LastRealDate =
			    CALCULATE (
			        MAX ( KIA_AGG_DATES[SUB_START_REAL] ),
			        FILTER (
			            KIA_AGG_DATES,
			            KIA_AGG_DATES[KIA] = _KIA
			                && KIA_AGG_DATES[SUB_FAZE_ID] = LastSubID
			        )
			    )
			
			/* 4️⃣ Modelový koniec KII (SUB_FAZE_ID = 42) */
			VAR ModelEndDate =
			    CALCULATE (
			        MAX ( KIA_AGG_DATES[SUB_KONEC_MODEL] ),
			        FILTER (
			            KIA_AGG_DATES,
			            KIA_AGG_DATES[KIA] = _KIA
			                && KIA_AGG_DATES[SUB_FAZE_ID] = 42
			        )
			    )
			
			VAR TodayDate =
			    TODAY()
			
			VAR EffectiveEndDate =
			    SWITCH (
			        TRUE (),
			
			        /* máme reálny dátum v budúcnosti alebo dnes */
			        NOT ISBLANK ( LastRealDate ) && LastRealDate >= TodayDate,
			            LastRealDate,
			
			        /* projekt stojí – dni po poslednom reálnom dátume bežia */
			        NOT ISBLANK ( LastRealDate ) && LastRealDate < TodayDate,
			            TodayDate,
			
			        /* prekročený model → meškanie */
			        NOT ISBLANK ( LastRealDate ) && TodayDate > ModelEndDate,
			            TodayDate,    
			
			        /* ešte nezačalo – ber model */
			        ISBLANK ( LastRealDate ),
			            ModelEndDate
			    )
			
			RETURN
			IF (
			    ISBLANK ( StartDate ) || ISBLANK ( EffectiveEndDate ),
			    BLANK (),
			    DATEDIFF ( StartDate, EffectiveEndDate, DAY )
			)
			
			```
		formatString: 0
		lineageTag: 4a1c3705-38c3-4986-b7a4-55631da94d0f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column KIA_ZPOZDENI_DAYS_COL = ```
			
			IF (
			    ISBLANK ( KIA_AGG_DATES[KIA_REAL_DURATION_DAYS_COL] )
			        || ISBLANK ( KIA_AGG_DATES[KIA_NORMA_DAYS] ),
			    BLANK (),
			    KIA_AGG_DATES[KIA_REAL_DURATION_DAYS_COL]
			        - KIA_AGG_DATES[KIA_NORMA_DAYS]
			)
			
			```
		formatString: 0
