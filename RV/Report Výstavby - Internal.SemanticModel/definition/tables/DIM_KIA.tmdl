	column 'Pocet Dnu Od Akvizice Ke Komerci' =
			
			VAR DatumAkvizice = DIM_KIA[ABC - Akvizice Start]
			VAR DatumKomerce = DIM_KIA[Komerce - RFS Real First]
			VAR DatumKmerci = IF(ISBLANK(DatumKomerce), TODAY(), DatumKomerce)
			VAR PocetDni = DATEDIFF(DatumAkvizice, DatumKmerci, DAY)
			RETURN
			IF(NOT ISBLANK(DatumAkvizice), PocetDni, BLANK())
		formatString: 0
		lineageTag: 1c93f5c7-84f6-4ac6-be2f-a3787c1c778d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Obec
		dataType: string
		lineageTag: 7bc296ad-6a0f-4896-892a-11f6cdaca8ec
		summarizeBy: none
		sourceColumn: Obec

		annotation SummarizationSetBy = Automatic

	column 'Realizace - Pripravenost Pro Zakaznika Opozdeni' =
			
			IF (
			    ISBLANK ( [Realizace - Pripravenost Pro Zakaznika Plan] )
			        || NOT ISBLANK ( [Realizace - Pripravenost Pro Zakaznika Real] ),
			    BLANK (),
			    IF (
			        DATEDIFF ( [Realizace - Pripravenost Pro Zakaznika Plan], TODAY (), DAY ) >= 10,
			        1,
			        BLANK ()
			    )
			)
		formatString: 0
		lineageTag: 808b5101-0bb7-42b9-b878-1a8f02d683ec
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Realizace - Ukonceni Opozdeni' =
			
			IF (
			    ISBLANK ( [Realizace - Ukonceni Plan] )
			        || NOT ISBLANK ( [Realizace - Ukonceni Real] ),
			    BLANK (),
			    IF (
			        DATEDIFF ( [Realizace - Ukonceni Plan], TODAY (), DAY ) >= 10,
			        1,
			        BLANK ()
			    )
			)
		formatString: 0
		lineageTag: e44e5aae-4b9e-4ddb-93ae-0be7808bb9ee
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Realizace - Zahajeni Opozdeni' =
			
			IF (
			    ISBLANK ( [Realizace - Zahajeni Plan] )
			        || NOT ISBLANK ( [Realizace - Zahajeni Real] ),
			    BLANK (),
			    IF (
			        DATEDIFF ( [Realizace - Zahajeni Plan], TODAY (), DAY ) >= 10,
			        1,
			        BLANK ()
			    )
			)
		formatString: 0
		lineageTag: 205c9d26-bc4a-43b3-9938-7cac8731b744
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

