	column 'Kvalita Vyplnenosti (%)' =
			
			VAR _totalCols = 10
			
			VAR _filled =
			    INT( NOT ISBLANK( DIM_KIA[Projekce - Projektovy Koordinator] ) ) +
			    INT( NOT ISBLANK( DIM_KIA[Projekce - Objednani Legislativy] ) ) +
			    INT( NOT ISBLANK( DIM_KIA[Projekce - Podani Zadosti UR] ) ) +
			    INT( NOT ISBLANK( DIM_KIA[Projekce - Nabiti Pravni Moci] ) ) +
			    INT( NOT ISBLANK( DIM_KIA[Projekce - Dodani DPS] ) ) +
			    INT( NOT ISBLANK( DIM_KIA[Projekce - Ukonceni Pripravy] ) ) +
			    INT( NOT ISBLANK( DIM_KIA[Realizace - Projektovy Koordinator] ) ) +
			    INT( NOT ISBLANK( DIM_KIA[Realizace - Zahajeni] ) ) +
			    INT( NOT ISBLANK( DIM_KIA[Realizace - Pripravenost Pro Zakaznika] ) ) +
			    INT( NOT ISBLANK( DIM_KIA[Realizace - Ukonceni] ) )
			
			RETURN
			DIVIDE(_filled, _totalCols)
		formatString: 0%;-0%;0%
		lineageTag: be1fa365-89a1-4445-b0e6-8f2f5604a56f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

