table FACT_DATA_QUALITY_INCIDENTS
	lineageTag: d7f147bb-0ac4-491f-b19d-460d767faae5

	measure 'Počet itemů v kontrole' = ```
			
			VAR _vse = CALCULATE ( COUNTROWS ( FACT_DATA_QUALITY_INCIDENTS ) )
			VAR _hp  = 
			    CALCULATE (
			        COUNTROWS ( FACT_DATA_QUALITY_INCIDENTS ),
			        FACT_DATA_QUALITY_INCIDENTS[DQ_Group_Label] = "ROP s 0 HP"
			    )
			RETURN
			    IF (
			        _vse = _hp && _vse > 0,
			        DISTINCTCOUNT ( FACT_DATA_QUALITY_INCIDENTS[ROP_ID] ),
			        SUM ( FACT_DATA_QUALITY_INCIDENTS[HP] )
			    )
			```
		formatString: #,0
		lineageTag: 1e0bf4b9-15b2-48bf-ac2d-36984f074fdd

	measure 'Pocet ROP Check Color' = ```
			
			VAR _hodnota = DISTINCTCOUNT ( FACT_DATA_QUALITY_INCIDENTS[ROP_ID] )
			VAR _hasAny = 
			    CALCULATE ( COUNTROWS ( FACT_DATA_QUALITY_INCIDENTS ) )
			VAR _hasNonHP = 
			    CALCULATE (
			        COUNTROWS ( FACT_DATA_QUALITY_INCIDENTS ),
			        KEEPFILTERS ( 
			            FACT_DATA_QUALITY_INCIDENTS[DQ_Group_Label] <> "Fáze s 0 HP" 
			        )
			    )
			VAR _isHP = 
			    NOT ISBLANK ( _hasAny ) && ISBLANK ( _hasNonHP )
			RETURN
			    IF (
			        ISBLANK ( _hodnota ),
			        BLANK (),
			        SWITCH (
			            TRUE (),
			            -- HP řádky: přísnější prahy
			            _isHP && _hodnota <= 100,    "#63BE7B",   -- zelená
			            _isHP && _hodnota <= 1000,   "#FFEB84",   -- žlutá
			            _isHP,                       "#F8696B",   -- červená
			            -- ostatní DQ skupiny: původní prahy
			            _hodnota <= 5000,            "#63BE7B",
			            _hodnota <= 10000,           "#FFEB84",
			                                         "#F8696B"
			        )
			    )
			```
		lineageTag: f4e11fad-eddc-4740-a455-5aeac7286a0c

