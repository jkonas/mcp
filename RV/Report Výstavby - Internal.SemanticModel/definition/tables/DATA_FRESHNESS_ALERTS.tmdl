table DATA_FRESHNESS_ALERTS
	lineageTag: ba4a9c10-80da-4706-aa2e-00a184d431a8

	measure DATA_FRESHNESS_ALERTS_Ikona = ```
			
			VAR _alertCount = 
			    CALCULATE(
			        COUNTROWS( 'DATA_FRESHNESS_ALERTS' ),
			        ALL( 'DATA_FRESHNESS_ALERTS' ),
			        'DATA_FRESHNESS_ALERTS'[Alert] = 1
			    )
			VAR _topN = 15
			VAR _fallback = DATE( YEAR(TODAY())-1, MONTH(TODAY()), DAY(TODAY()) )
			VAR _alertsWithRefresh = 
			    ADDCOLUMNS(
			        FILTER( ALL('DATA_FRESHNESS_ALERTS'), 'DATA_FRESHNESS_ALERTS'[Alert] = 1 ),
			        "@Refresh", COALESCE('DATA_FRESHNESS_ALERTS'[Data Source Refresh DateTime], _fallback)
			    )
			VAR _topAlerts = TOPN( _topN, _alertsWithRefresh, [@Refresh], ASC )
			VAR _alertList = 
			    CONCATENATEX(
			        _topAlerts,
			        VAR _d = DATEDIFF( [@Refresh], TODAY(), DAY )
			        VAR _icon = SWITCH( TRUE(), _d <= 1, "🟢", _d <= 7, "🟡", "🔴" )
			        RETURN
			            _icon & "  " & SUBSTITUTE( 'DATA_FRESHNESS_ALERTS'[Data Source name], "'", "´" ) & UNICHAR(10)
			            & "    📅 " & FORMAT( [@Refresh], "yyyy-MM-dd" )
			            & "   ⏱ " & _d & " dní",
			        UNICHAR(10) & UNICHAR(10),
			        [@Refresh], ASC
			    )
			VAR _remaining = _alertCount - _topN
			VAR _line = "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
			VAR _tooltip = 
			    "⚠  NEAKTUÁLNÍ ZDROJE  (" & _alertCount & ")" & UNICHAR(10)
			    & _line & UNICHAR(10) & UNICHAR(10)
			    & _alertList
			    & IF( _remaining > 0, 
			        UNICHAR(10) & UNICHAR(10) & _line & UNICHAR(10) & "…a další " & _remaining & " zdrojů", 
			        "" )
			RETURN
			    IF(
			        _alertCount > 0,
			        "<span title='" & _tooltip & "' style='font-size:14px;cursor:help;animation:blink 4s infinite;'>⚠️</span>
			         <style>@keyframes blink {50% {opacity:0.2;}}</style>",
			        ""
			    )
			```
