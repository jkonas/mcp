	partition MILESTONES_KOMERCE_ROP = calculated
		mode: import
		source = ```
				
				VAR Forecasts =
				    SUMMARIZE(
				        FILTER(MILESTONES_KOMERCE, MILESTONES_KOMERCE[Milnik ID] = 75),
				        MILESTONES_KOMERCE[ROP_Key],
				        "EventType",  "Dokumentace Odevzdána (Forecast)",
				        "EventColor", "#D4EBF2",
				        "EventDateShort",  FORMAT(MIN(MILESTONES_KOMERCE[Milnik Datum]), "YY\/MM"),
				        "EventDate",  MIN(MILESTONES_KOMERCE[Milnik Datum]),
				        "Počet HP",   MAX(MILESTONES_KOMERCE[Pocet HP])
				    )
				VAR Starts =
				    SUMMARIZE(
				        FILTER(MILESTONES_KOMERCE, NOT ISBLANK(MILESTONES_KOMERCE[ROP KPI Start])),
				        MILESTONES_KOMERCE[ROP_Key],
				        "EventType",  "Dokumentace Odevzdána (Real)",
				        "EventColor", "#41B6E6",
				        "EventDateShort",  FORMAT(MIN(MILESTONES_KOMERCE[ROP KPI Start]), "YY\/MM"),
				        "EventDate",  MIN(MILESTONES_KOMERCE[ROP KPI Start]),        
				        "Počet HP",   MAX(MILESTONES_KOMERCE[Pocet HP])
				    )
				VAR Ends =
				    SUMMARIZE(
				        FILTER(MILESTONES_KOMERCE, NOT ISBLANK(MILESTONES_KOMERCE[ROP KPI End])),
				        MILESTONES_KOMERCE[ROP_Key],
				        "EventType",  "Home Passed (Real)",
				        "EventColor", "#3E7C4A",
				        "EventDateShort",  FORMAT(MIN(MILESTONES_KOMERCE[ROP KPI End]), "YY\/MM"),
				        "EventDate",  MAX(MILESTONES_KOMERCE[ROP KPI End]),        
				        "Počet HP",   MAX(MILESTONES_KOMERCE[Pocet HP])
				    )
				RETURN
				UNION(Forecasts, Starts, Ends)
				
				```

	annotation PBI_Id = 6486aa4f19dc4378ab24ddc19e3985df

