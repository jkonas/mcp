model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: cs-CZ
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Aktivita","Prispevek","Ucet","Uzivatel","Transakce","_Kalendar","Miry"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Top N'
ref table _Kalendar
ref table Aktivita
ref table Prispevek
ref table Ucet
ref table Uzivatel
ref table Transakce

ref cultureInfo cs-CZ
ref cultureInfo en-US

